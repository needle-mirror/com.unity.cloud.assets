.ContentContainer {
    margin-top: 10px;
    margin-bottom: 20px;
    margin-left: 10px;
    margin-right: 10px;
}

#AssetGridItemContainer {
    margin: 1px;
}

#ProjectsPanel {
    background-color: rgb(28, 28, 28);
    border-color: rgba(255, 255, 255, 0.48);
}

#AssetDownloadButton {
    background-color: rgb(41, 161, 255);
    width: 100%;
    height: 100%;
    margin-top: 12px;
    -unity-font-style: bold;
    border-radius: 6px;
    transition-duration: 0.25s;
    transition-timing-function: ease-out-back;
    color: rgb(210, 210, 210);
    border-color: rgb(41, 161, 255);
}

#AssetDownloadButton:hover {
    background-color: rgb(88, 195, 255);
}

#AssetDownloadButton:disabled {
    background-color: rgba(255, 255, 255, 0.82);
    border-color: rgba(255, 255, 255, 0.82);
}

#AssetDownloadSuccessful {
    margin-top: 5px;
    color: rgb(210, 210, 210);
}

#DatasetDownloadButton {
    background-color: rgb(41, 161, 255);
    width: 100%;
    height: 100%;
    margin-top: 12px;
    -unity-font-style: bold;
    border-radius: 6px;
    transition-duration: 0.25s;
    transition-timing-function: ease-out-back;
    color: rgb(210, 210, 210);
    border-color: rgb(41, 161, 255);
}

#DatasetDownloadButton:hover {
    background-color: rgb(88, 195, 255);
}

#DatasetDownloadButton:disabled {
    background-color: rgba(255, 255, 255, 0.82);
    border-color: rgba(255, 255, 255, 0.82);
}

#DatasetDownloadSuccessful {
    margin-top: 5px;
    color: rgb(210, 210, 210);
}

#tabs {
    flex-direction: row;
    background-color: rgb(229, 223, 223);
    -unity-font-style: bold;
    font-size: 14px;
    flex-grow: 1;
}

.tab {
    flex-grow: 1;
    align-items: center;
    -unity-text-align: upper-center;
    background-color: rgb(48, 48, 48);
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.currentlySelectedTab {
    background-color: rgb(74, 77, 221);
}

.unselectedContent {
    display: none;
}
