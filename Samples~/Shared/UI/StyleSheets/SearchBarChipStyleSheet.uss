#SearchBarChipDeleteButton {
    -unity-background-image-tint-color: rgb(160, 160, 160);
}

#SearchBarChipDeleteButton:hover {
    -unity-background-image-tint-color: rgb(112, 112, 112);
}

#SearchBarChip {
    background-color: rgba(80, 80, 80, 255);
    border-top-left-radius: 16px;
    border-bottom-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-right-radius: 16px;
}
