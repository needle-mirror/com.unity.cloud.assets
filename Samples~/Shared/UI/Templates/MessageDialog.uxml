<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="../StyleSheets/DialogSheet.uss?fileID=7433441132597879392&amp;guid=aba348b0fbee15144b2e5ef2b079ccc6&amp;type=3#DialogSheet" />
    <ui:VisualElement name="DialogContainer" style="background-color: rgb(19, 19, 19); justify-content: center; align-items: center; width: 100%; height: 100%; min-width: 100%; min-height: 100%; max-width: 100%; max-height: 100%; display: none;">
        <ui:VisualElement name="Dialog">
            <ui:Label text="Title..." display-tooltip-when-elided="true" name="Title" picking-mode="Ignore" style="-unity-font: url(&apos;project://database/Library/unity%20default%20resources?fileID=10102&amp;guid=0000000000000000e000000000000000&amp;type=0#LegacyRuntime&apos;); width: 100%;" />
            <ui:Label text="Message..." display-tooltip-when-elided="true" name="Message" style="width: 100%; -unity-text-align: upper-center; -unity-font: url(&apos;project://database/Library/unity%20default%20resources?fileID=10102&amp;guid=0000000000000000e000000000000000&amp;type=0#LegacyRuntime&apos;);" />
            <ui:VisualElement name="OkButtonContainer" style="align-items: center; justify-content: center;">
                <ui:Button text="Ok" display-tooltip-when-elided="true" name="OkButton" Style="width: 50%; align-items: stretch;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
