        <ui:Label text="Lorem Ipsum" display-tooltip-when-elided="true" name="Label" style="color: rgb(210, 210, 210); -unity-text-align: middle-left; font-size: 10px; flex-grow: 1; overflow: hidden; flex-shrink: 1;" />
        <ui:Button display-tooltip-when-elided="true" name="DeleteButton" style="background-image: url(&apos;project://database/Packages/com.unity.cloud.assets/Samples/Shared/UI/Sprites/delete.png?fileID=21300000&amp;guid=2fba3b8e11a714aeca7937eb158f6f0b&amp;type=3#delete&apos;); border-top-left-radius: 10px; border-bottom-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-left-color: rgba(255, 255, 255, 0); border-right-color: rgba(255, 255, 255, 0); border-top-color: rgba(255, 255, 255, 0); border-bottom-color: rgba(255, 255, 255, 0); background-color: rgba(88, 88, 88, 0); width: 20px; height: 20px; -unity-background-scale-mode: scale-to-fit; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;" />
