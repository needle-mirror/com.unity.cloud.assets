<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="OrganizationsContainer" src="../Templates/OrganizationsContainer.uxml?fileID=9197481963319205126&amp;guid=7774487f886b24ea28232786a6edeb40&amp;type=3#OrganizationsContainer" />
    <ui:Template name="LeftListContainer" src="../Templates/ListContainer.uxml?fileID=9197481963319205126&amp;guid=bc40760b2b12c4af4a3fe093fd2c100a&amp;type=3#ListContainer" />
    <ui:Template name="ContextMenu" src="../Templates/ContextMenu.uxml?fileID=9197481963319205126&amp;guid=013acd66da79b4563b22404be89cbf17&amp;type=3#ContextMenu" />
    <Style src="../StyleSheets/SampleSheet.uss?fileID=7433441132597879392&amp;guid=7376c3d25e9f04a989663c45cc94f5c7&amp;type=3#SampleSheet" />
    <ui:VisualElement name="TopBar">
            <ui:Instance template="OrganizationsContainer" name="OrganizationsContainer" style="align-items: flex-end; width: 100%;" />
        </ui:VisualElement>
    <ui:VisualElement name="ContentContainer" style="flex-direction: row; background-color: rgb(0, 0, 0); flex-grow: 1;">
        <ui:VisualElement name="LeftPanel" class="ContentContainer" style="overflow: hidden; padding-left: 8px; padding-right: 0; padding-top: 0; padding-bottom: 8px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; background-color: rgb(28, 28, 28); width: 20%; max-width: 400px;">
            <ui:Instance template="LeftListContainer" name="LeftListContainer" style="flex-grow: 1;">
                    <AttributeOverrides element-name="ListLabel" text="Projects" />
                    <ui:Instance template="ContextMenu" name="LeftPanelContextMenu" class="ContextMenuContainer" style="display: flex;" />
                </ui:Instance>
            </ui:VisualElement>
            <ui:VisualElement name="Content" style="margin-left: 8px; margin-right: 8px; margin-top: 8px; margin-bottom: 8px; flex-grow: 1;">
                <ui:VisualElement name="SearchBarContainer" style="flex-shrink: 0;" />
                <ui:VisualElement name="ContentPanel" style="margin-left: 8px; margin-right: 8px; margin-top: 8px; margin-bottom: 8px; flex-grow: 1; flex-direction: row;" />
            <ui:VisualElement name="SearchValuesCloseButton" picking-mode="Ignore" style="position: absolute; top: 40px; padding-bottom: 40px; width: 100%; height: 100%;">
                <ui:ListView name="SearchValues" show-border="true" selection-type="Single" virtualization-method="DynamicHeight" style="white-space: nowrap; background-color: rgb(48, 48, 48); color: rgb(210, 210, 210); -unity-font-style: bold; -unity-background-scale-mode: scale-and-crop; border-top-left-radius: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 3px; border-bottom-left-radius: 3px; align-self: flex-start; display: none; width: 40%;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
</ui:UXML>
