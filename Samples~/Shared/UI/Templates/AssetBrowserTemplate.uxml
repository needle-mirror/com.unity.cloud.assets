<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="OrganizationsContainer" src="../Templates/OrganizationsContainer.uxml?fileID=9197481963319205126&amp;guid=7774487f886b24ea28232786a6edeb40&amp;type=3#OrganizationsContainer" />
    <ui:Template name="LeftListContainer" src="../Templates/ListContainer.uxml?fileID=9197481963319205126&amp;guid=bc40760b2b12c4af4a3fe093fd2c100a&amp;type=3#ListContainer" />
    <ui:Template name="ContextMenu" src="../Templates/ContextMenu.uxml?fileID=9197481963319205126&amp;guid=013acd66da79b4563b22404be89cbf17&amp;type=3#ContextMenu" />
    <Style src="../StyleSheets/SampleSheet.uss?fileID=7433441132597879392&amp;guid=7376c3d25e9f04a989663c45cc94f5c7&amp;type=3#SampleSheet" />
    <Style src="../StyleSheets/ContextMenuStyleSheet.uss?fileID=7433441132597879392&amp;guid=aad11b3cc0a914227ad16f5524ef8075&amp;type=3#ContextMenuStyleSheet" />
    <Style src="../StyleSheets/Popups.uss?fileID=7433441132597879392&amp;guid=ea7c14029cf904c2e9d83863be857eec&amp;type=3#Popups" />
    <ui:VisualElement style="background-color: rgb(19, 19, 19); width: 100%; height: 100%; flex-grow: 1;">
        <ui:VisualElement name="TopBar" style="flex-grow: 1;">
            <ui:Instance template="OrganizationsContainer" name="OrganizationsContainer" style="align-items: flex-end; width: 100%;" />
        </ui:VisualElement>
        <ui:VisualElement name="ContentContainer" style="flex-direction: row; height: 100%; background-color: rgb(0, 0, 0);">
            <ui:VisualElement name="LeftPanel" class="ContentContainer" style="overflow: hidden; padding-left: 8px; padding-right: 0; padding-top: 0; padding-bottom: 8px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; background-color: rgb(28, 28, 28); width: 20%;">
                <ui:Instance template="LeftListContainer" name="LeftListContainer">
                    <AttributeOverrides element-name="ListLabel" text="Projects" />
                    <ui:Instance template="ContextMenu" name="LeftPanelContextMenu" class="ContextMenuContainer" style="display: flex;" />
                </ui:Instance>
            </ui:VisualElement>
            <ui:VisualElement name="Content" style="margin-left: 8px; margin-right: 8px; margin-top: 8px; margin-bottom: 8px; flex-grow: 1;">
                <ui:VisualElement name="SearchBarContainer" style="flex-shrink: 0;" />
                <ui:VisualElement name="ContentPanel" style="margin-left: 8px; margin-right: 8px; margin-top: 8px; margin-bottom: 8px; flex-grow: 1; flex-direction: row;" />
                <ui:VisualElement name="SearchValuesCloseButton" picking-mode="Ignore" style="width: 100%; height: 100%; position: absolute; top: 40px; padding-bottom: 40px;">
                    <ui:ListView name="SearchValues" show-border="true" selection-type="Single" style="align-items: stretch; white-space: nowrap; background-color: rgb(48, 48, 48); color: rgb(210, 210, 210); -unity-font-style: bold; -unity-background-scale-mode: scale-and-crop; width: 60%; height: 100%; padding-left: 4px; padding-right: 4px; padding-top: 4px; padding-bottom: 4px; display: none; margin-bottom: 25px; min-width: 200px; max-height: none; min-height: 60px; border-top-left-radius: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 3px; border-bottom-left-radius: 3px;" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement picking-mode="Ignore" name="PopupContainer" class="PopupContainer">
                <ui:VisualElement name="MessagePopup" class="Popup">
                    <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                        <ui:Label text="Title" name="Title" style="font-size: 18px; -unity-font-style: bold; margin-bottom: 8px; color: rgb(210, 210, 210); margin-top: 8px; margin-left: 8px; margin-right: 2px; padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; flex-grow: 1;" />
                        <ui:Button display-tooltip-when-elided="true" name="Close" class="PopupClose" />
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-direction: column; padding-top: 12px; padding-bottom: 12px; margin-top: 2px; margin-right: 4px; margin-bottom: 2px; margin-left: 4px;">
                        <ui:Label display-tooltip-when-elided="true" name="Message" text="Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua." style="display: flex; color: rgb(197, 197, 197); white-space: normal; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;" />
                    </ui:VisualElement>
                    <ui:VisualElement style="align-items: center; flex-direction: row; justify-content: center;">
                        <ui:Button text="Cancel" name="Cancel" class="PopupButton" />
                        <ui:Button text="Ok" name="Action" class="PopupButton" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="TextInputPopup" class="Popup" style="min-width: 450px;">
                    <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                        <ui:Label text="Title" name="Title" style="font-size: 18px; -unity-font-style: bold; margin-bottom: 8px; color: rgb(210, 210, 210); margin-top: 8px; margin-left: 8px; margin-right: 2px; padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; flex-grow: 1;" />
                        <ui:Button display-tooltip-when-elided="true" name="Close" class="PopupClose" />
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-direction: column; padding-top: 12px; padding-bottom: 12px; margin-top: 2px; margin-right: 4px; margin-bottom: 2px; margin-left: 4px;">
                        <ui:Label display-tooltip-when-elided="true" name="Message" text="Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua." style="display: flex; color: rgb(197, 197, 197); white-space: normal; margin-top: 4px; margin-right: 0; margin-bottom: 4px; margin-left: 0;" />
                        <ui:TextField picking-mode="Ignore" value="filler text" style="margin-top: 4px; margin-right: 0; margin-bottom: 4px; margin-left: 0;" />
                    </ui:VisualElement>
                    <ui:VisualElement style="align-items: center;">
                        <ui:Button text="Ok" name="Action" class="PopupButton" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
