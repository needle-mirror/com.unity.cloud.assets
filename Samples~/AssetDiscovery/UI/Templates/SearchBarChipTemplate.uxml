<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Packages/com.unity.cloud.assets/Samples/AssetDiscovery/UI/StyleSheets/SearchBarChipStyleSheet.uss?fileID=7433441132597879392&amp;guid=5ad5f481db5de489898e5617d18756f0&amp;type=3#SearchBarChipStyleSheet" />
    <ui:VisualElement name="SearchBarChip" style="flex-direction: row; margin-left: 3px; margin-right: 3px; margin-top: 6px; margin-bottom: 6px; align-items: center; justify-content: flex-start; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgb(78, 78, 78); border-right-color: rgb(78, 78, 78); border-top-color: rgb(78, 78, 78); border-bottom-color: rgb(78, 78, 78); border-top-left-radius: 18px; border-bottom-left-radius: 18px; border-top-right-radius: 18px; border-bottom-right-radius: 18px; font-size: 10px; flex-shrink: 0;">
        <ui:VisualElement name="ChipLabel" style="margin-left: 9px; margin-top: 3px; margin-bottom: 3px; white-space: nowrap; overflow: hidden;">
            <ui:Label text="Label" display-tooltip-when-elided="true" name="SearchBarChipLabel" style="color: rgb(210, 210, 210); padding-left: 3px; padding-right: 3px; padding-top: 3px; padding-bottom: 3px; -unity-text-align: middle-left;" />
        </ui:VisualElement>
        <ui:VisualElement name="DeleteButton" style="width: initial; padding-left: 3px; padding-right: 3px; padding-top: 3px; padding-bottom: 3px; margin-left: 3px; margin-right: 3px; margin-top: 3px; margin-bottom: 3px;">
            <ui:Button display-tooltip-when-elided="true" name="SearchBarChipDeleteButton" style="background-image: url(&apos;project://database/Packages/com.unity.cloud.assets/Samples/AssetDiscovery/UI/Sprites/delete.png?fileID=21300000&amp;guid=2fba3b8e11a714aeca7937eb158f6f0b&amp;type=3#delete&apos;); border-top-left-radius: 10px; border-bottom-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-left-color: rgba(255, 255, 255, 0); border-right-color: rgba(255, 255, 255, 0); border-top-color: rgba(255, 255, 255, 0); border-bottom-color: rgba(255, 255, 255, 0); background-color: rgba(88, 88, 88, 0); width: 15px; height: 15px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
