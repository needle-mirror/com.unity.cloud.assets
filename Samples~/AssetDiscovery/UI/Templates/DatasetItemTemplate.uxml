<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="../StyleSheets/AssetInformationPanelStyleSheet.uss?fileID=7433441132597879392&amp;guid=6106b709427544a248238f9563ef3780&amp;type=3#AssetInformationPanelStyleSheet" />
    <ui:Foldout name="DataSetFoldout" text="DataSet" value="false" style="height: 100%; width: 100%; display: flex; color:white">
        <ui:VisualElement name="DataSetInformationContainer" style="width: 100%; height: 100%;">
            <ui:ScrollView name="DataSetInformationScrollView" />
            <ui:Button name="DatasetDownloadButton" text="Download" display-tooltip-when-elided="true" style="width: 98%; height: 7%; display:none;" />
            <ui:VisualElement name="DatasetDownloadSuccessful" style="display: none; height: 3%; transition-duration: 1s; transition-timing-function: ease-in;">
                <ui:Label name="DatasetDownloadSuccessfulLabel" text="Download successful to Desktop!" display-tooltip-when-elided="true" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:Foldout>
</ui:UXML>
