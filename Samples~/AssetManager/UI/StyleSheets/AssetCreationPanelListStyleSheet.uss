#ListContainer {
    padding-left: 16px;
    padding-right: 16px;
    background-color: rgb(19, 19, 19);
    border-color: rgb(48, 48, 48);
    border-width: 1px;
    min-height: 55px;
}

#ListContainer Label {
    color: rgba(255, 255, 255, 0.82);
    font-size: 13px;
    margin-top: 2px;
    margin-right: 2px;
    margin-bottom: 2px;
    margin-left: 2px;
    padding-top: 4px;
    padding-right: 4px;
    padding-bottom: 4px;
    padding-left: 4px;
}

#ListContainer:hover {
    border-color: rgb(48, 48, 48);
    background-color: rgb(48, 48, 48);
}

#DeleteIcon {
    width: 20px;
    height: 20px;
    background-image: url('../Sprites/delete_can.png?fileID=21300000&guid=6c9cea01357fe4f299a5d51b5e7f57ae&type=3#delete_can');
    -unity-background-image-tint-color: rgb(112, 112, 112);
    -unity-background-scale-mode: scale-to-fit;
}

#DeleteIcon:hover {
    -unity-background-image-tint-color: rgb(160, 160, 160);
}
