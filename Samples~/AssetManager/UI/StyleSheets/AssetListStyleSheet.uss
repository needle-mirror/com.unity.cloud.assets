.unity-button {
    border-radius: 4px;
}

#ListContainer {
    background-color: rgb(19, 19, 19);
    width: 100%;
    height: 100%;
}

#AssetListLabel {
    color: rgb(210, 210, 210);
    font-size: 20px;
}

#AssetListBottomBar {
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

#LeftTopPanel {
    width: 95%;
    border-right-color: rgba(0, 0, 0, 0);
    border-top-left-radius: 4px;
}

#AddAssetButton {
    color: rgba(255, 255, 255, 0.82);
    background-color: rgb(41, 161, 255);
    border-color: rgb(41, 161, 255);
    transition-duration: 0.25s;
    transition-timing-function: ease-out-back;
    padding: 4px 8px;
}

#AddAssetButton:hover {
    background-color: rgb(76, 176, 255);
    border-color: rgb(76, 176, 255);
}

#ExpandButton {
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    background-image: url('../../../Shared/UI/Sprites/expand.png?fileID=21300000&guid=f003f64c5b9534b98a42a77250bb34fa&type=3#expand');
    -unity-background-image-tint-color: rgb(112, 112, 112);
    background-color: rgba(0, 0, 0, 0);
}

#ExpandButton:hover {
    background-color: rgb(48, 48, 48);
}

#OpenButton {
    color: rgb(210, 210, 210);
    border-radius: 4px;
    transition-duration: 0.25s;
    transition-timing-function: ease-out-back;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    background-color: rgba(48, 48, 48, 0);
}

#OpenButton:hover {
    background-color: rgb(48, 48, 48);
}

.AssetListLeftBar {
    background-color: rgb(28, 28, 28);
    border-color: rgb(81, 81, 81);
    border-width: 0.5px;
    height: 100%;
    -unity-text-align: middle-left;
    font-size: 13px;
    color: rgb(210, 210, 210);
    flex-direction: row;
    justify-content: space-around;
    flex-grow: 1;
    overflow: hidden;
}

.AssetListRightBar {
    width: 40px;
    height: 100%;
    border-color: rgb(81, 81, 81);
    border-width: 0.5px;
    background-color: rgb(36, 36, 36);
    border-left-color: rgba(81, 81, 81, 0);
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    flex-shrink: 0;
}

.AssetListItem {
    -unity-text-align: middle-center;
    flex-direction: row;
    justify-content: center;
    padding-top: 5px;
    padding-bottom: 5px;
    flex-shrink: 0;
}

.AssetListItemLeftBar {
    background-color: rgb(19, 19, 19);
    border-color: rgb(81, 81, 81);
    border-width: 0.5px;
    border-top-color: rgba(81, 81, 81, 0);
}

.AssetListItemLabel {
}
