#AssetListContainer {
    background-color: rgb(19, 19, 19);
    width: 100%;
    height: 100%;
}

#AssetListLabel {
    color: rgb(210, 210, 210);
    font-size: 20px;
}

#AddAssetButton {
    color: rgba(255, 255, 255, 0.82);
    background-color: rgb(41, 161, 255);
    border-color: rgb(41, 161, 255);
    transition-duration: 0.25s;
    transition-timing-function: ease-out-back;
    padding: 4px 8px;
}

#AddAssetButton:hover {
    background-color: rgb(76, 176, 255);
    border-color: rgb(76, 176, 255);
}

.AssetListLeftBar {
    height: 100%;
    background-color: rgb(28, 28, 28);
    border-color: rgb(81, 81, 81);
    border-width: 0.5px;
}

.AssetListRightBar {
    width: 5%;
    height: 100%;
    border-color: rgb(81, 81, 81);
    border-width: 0.5px;
    background-color: rgb(36, 36, 36);
    border-left-color: rgba(81, 81, 81, 0);
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

.LeftPanel {
    flex-direction: row;
    color: rgb(210, 210, 210);
    font-size: 13px;
    -unity-text-align: middle-left;
    justify-content: space-around;
}

#LeftTopPanel {
    width: 95%;
    border-right-color: rgba(0, 0, 0, 0);
    border-top-left-radius: 4px;
}

#LeftBottomPanel {
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

#ExpandButton {
    width: 20%;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    background-image: url('../../../Shared/UI/Sprites/expand.png?fileID=21300000&guid=f003f64c5b9534b98a42a77250bb34fa&type=3#expand');
    -unity-background-image-tint-color: rgb(112, 112, 112);
    background-color: rgba(0, 0, 0, 0);
}

#ExpandButton:hover {
    background-color: rgb(40, 40, 40);
}

.AssetListItem {
    width: 12.5%;
    -unity-text-align: middle-center;
    flex-wrap: wrap;
    max-width: 12.5%;
    flex-direction: row;
    justify-content: center;
    padding-top: 5px;
    padding-bottom: 5px;
}

.AssetListItemLeftBar {
    background-color: rgb(19, 19, 19);
    border-color: rgb(81, 81, 81);
    border-width: 0.5px;
    border-top-color: rgba(81, 81, 81, 0);
}

#MenuPopup {
    position: absolute;
    background-color: rgb(28, 28, 28);
    border-color: rgb(28, 28, 28);
    border-radius: 8px;
    padding: 5px 8px;
    width: 100px;
    left: -80px;
    transition-duration: 0.25s;
    transition-timing-function: ease-out-back;
}

.MenuPopupButton {
    color: rgb(210, 210, 210);
    background-color: rgba(0, 0, 0, 0);
    border-radius: 4px;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    transition-duration: 0.25s;
    transition-timing-function: ease-out-back;
}

.MenuPopupButton:hover {
    background-color: rgb(56, 56, 56);
}
