<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Template name="AssetCreationStatusTemplate" src="./AssetCreationStatusTemplate.uxml?fileID=9197481963319205126&amp;guid=d9c920e1e88944d778bb4f519a50db76&amp;type=3#AssetCreationStatusTemplate" />
    <Style src="../StyleSheets/AssetCreationPanelStyleSheet.uss?fileID=7433441132597879392&amp;guid=2a9d0e7b4e75049048525c21e638987e&amp;type=3#AssetCreationPanelStyleSheet" />
    <ui:VisualElement name="AssetCreationContainer" style="height: 100%; width: 100%; background-color: rgb(19, 19, 19); justify-content: center; min-width: 100%; min-height: 100%; max-width: 100%; max-height: 100%;">
        <ui:VisualElement style="flex-grow: 1;">
            <ui:Button text="Back" parse-escape-sequences="true" display-tooltip-when-elided="true" name="BackBtn" style="flex-shrink: initial; flex-direction: row; flex-basis: initial; width: 100px;" />
        </ui:VisualElement>
        <ui:VisualElement name="ContentContainer" style="flex-direction: row; height: 90%; width: 100%; display: flex;">
            <ui:VisualElement name="LeftPanel" style="height: 97%; display: flex; flex-direction: column; flex-grow: 1;">
                <ui:VisualElement name="AssetFileListContainer" style="height: 100%; width: 100%; display: flex; flex-grow: 1;">
                    <ui:ScrollView name="DatasetScrollView" class="AssetFile" style="flex-grow: 1;" />
                    <ui:VisualElement name="DatasetCreation" style="align-items: center; max-height: 30px;">
                        <ui:Button text="Create Dataset" display-tooltip-when-elided="true" visible="false" name="CreateDatasetButton" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="RightPanel" style="min-width: 50% height 97%; display: flex;">
                <ui:VisualElement name="AssetTitleContainer">
                    <ui:VisualElement name="AssetTitle" class="AssetTitle">
                        <ui:Label text="Asset Name" display-tooltip-when-elided="true" name="AssetTitleLabel" style="-unity-font-style: bold;" />
                    </ui:VisualElement>
                    <ui:VisualElement name="AssetSubtitle" class="AssetTitle" style="height: 50%; flex-direction: row;">
                        <ui:VisualElement name="AssetStatus">
                            <ui:Instance template="AssetCreationStatusTemplate" name="AssetCreationStatusTemplate" />
                        </ui:VisualElement>
                        <ui:VisualElement name="AssetLastEdit" class="AssetLastEdit" style="flex-direction: row; -unity-text-align: middle-left; display: none;">
                            <ui:Label text="Last Edit: " display-tooltip-when-elided="true" name="AssetLastEditLabel" />
                            <ui:Label text="Label" display-tooltip-when-elided="true" name="AssetLastEditDateLabel" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="AssetInfoContainer" style="justify-content: flex-start;">
                    <ui:VisualElement name="AssetType" class="RightPanelInputs">
                        <ui:DropdownField label="Asset Type" index="-1" choices="System.Collections.Generic.List`1[System.String]" name="AssetTypeDropdown" />
                    </ui:VisualElement>
                    <ui:VisualElement name="AssetName" class="RightPanelInputs">
                        <ui:TextField picking-mode="Ignore" label="Asset Name" value="filler text" name="AssetNameField" />
                    </ui:VisualElement>
                    <ui:VisualElement name="AssetTags" class="RightPanelInputs">
                        <ui:TextField name="AssetTagsField" value="filler text" picking-mode="Ignore" label="Tags" />
                        <ui:VisualElement name="AssetTagsChipContainer" style="flex-direction: row; flex-wrap: wrap;" />
                    </ui:VisualElement>
                    <ui:VisualElement name="AssetDescription" style="min-height: 30%;">
                        <ui:TextField picking-mode="Ignore" label="Description" value="filler text" text="Description" name="AssetDescriptionField" style="color: rgb(210, 210, 210);" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="AssetPublishContainer" style="justify-content: flex-end; align-items: flex-end;">
                    <ui:VisualElement name="AssetButtonContainer" style="flex-direction: row; align-items: center; justify-content: flex-end;">
                        <ui:Button text="Publish asset" display-tooltip-when-elided="true" visible="false" name="AssetPublishButton" />
                        <ui:Button text="Save asset" display-tooltip-when-elided="true" visible="false" name="AssetSaveButton" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
