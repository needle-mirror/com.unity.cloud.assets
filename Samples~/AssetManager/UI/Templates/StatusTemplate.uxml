<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <Style src="../StyleSheets/AssetCreationPanelStyleSheet.uss?fileID=7433441132597879392&amp;guid=2a9d0e7b4e75049048525c21e638987e&amp;type=3#AssetCreationPanelStyleSheet" />
    <ui:VisualElement style="flex-direction: row; margin-top: 4px; margin-right: 4px; margin-bottom: 4px; margin-left: 4px; flex-shrink: 0;">
        <ui:VisualElement style="align-items: center; border-top-left-radius: 10px; border-bottom-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; background-color: rgb(46, 46, 46); overflow: hidden; flex-direction: row; min-width: 25px;">
            <ui:VisualElement name="StatusCircle" style="background-image: url(&apos;../Sprites/circle.png?fileID=21300000&amp;guid=4ed74cdf079474f2995fef61e432e694&amp;type=3#circle&apos;); flex-shrink: 0; height: 15px; margin-top: 5px; margin-right: 5px; margin-bottom: 5px; margin-left: 5px; width: 15px;" />
            <ui:Label text="Status Status Status Status Status Status Status Status Status Status Status" display-tooltip-when-elided="true" name="StatusNameLabel" style="flex-grow: 1; margin-top: 2px; margin-right: 5px; margin-bottom: 2px; margin-left: 2px; -unity-font-style: bold; flex-shrink: 1;" />
        </ui:VisualElement>
        <ui:VisualElement style="flex-direction: row; -unity-text-align: middle-left; flex-grow: 1; padding-left: 8px; padding-top: 2px; padding-right: 2px; padding-bottom: 2px; min-width: 70%; flex-shrink: 0;">
            <ui:Label text="Last Edit: " display-tooltip-when-elided="true" style="flex-shrink: 1; overflow: hidden; text-overflow: clip;" />
            <ui:Label text="Timestamp" display-tooltip-when-elided="true" name="LastEditDate" style="flex-grow: 1;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
